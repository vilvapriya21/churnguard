# Copy this file to .env and fill in real values. Never commit .env.
#
# Which settings file to load: dev, staging or prod.
APP_ENV=dev

# Optional overrides for values in configs/<env>.yaml.
# Nested keys use a double underscore.
CHURNGUARD_LOG_LEVEL=
CHURNGUARD_MLFLOW__TRACKING_URI=

# Secrets for a remote MLflow server (leave empty for the local store).
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Secrets for the DVC remote storage (Task 5).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
