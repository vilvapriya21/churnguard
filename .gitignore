# Data and models are versioned with DVC, not Git
/data/raw/*
/data/interim/*
/data/processed/*
/models/*
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/models/.gitkeep
!/data/**/*.dvc
!/models/*.dvc

